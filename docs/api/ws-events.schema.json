          "session_id",
          "event_id",
          "translation_index",
          "source_segment_ids",
          "source_text",
          "text",
          "direction",
          "latency_mode",
          "forced",
          "inference_ms"
        ],
        "title": "TranslationSegment",
        "type": "object"
      },
