            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "translation_index": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Translation Index",
            "type": "integer"
          },
          "type": {
            "const": "translation.segment",
            "default": "translation.segment",
            "title": "Type",
            "type": "string"
          }
        },
