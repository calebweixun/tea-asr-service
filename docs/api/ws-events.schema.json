      "TranscriptStable": {
        "additionalProperties": false,
        "description": "Append-only view of one segment for live subtitles (opt-in).\n\n`text` is the segment's whole committed text, never a delta: every event\nfor a `segment_id` has a `text` that starts with the previous one's, cut\nonly at grapheme-cluster boundaries. `state=\"open\"` may be followed by more;\nany other state is the segment's last `transcript.stable`. It never\nreplaces `transcript.partial` or `transcript.final`: the transcript, exports\nand translation keep using `transcript.final`.",
        "properties": {
          "diverged_chars": {
            "default": 0,
            "minimum": 0,
            "title": "Diverged Chars",
            "type": "integer"
          },
          "end_sample": {
            "title": "End Sample",
            "type": "integer"
          },
          "event_id": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Event Id",
            "type": "integer"
          },
          "segment_id": {
            "title": "Segment Id",
            "type": "string"
          },
          "segment_index": {
            "title": "Segment Index",
            "type": "integer"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "source_revision": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": "Source Revision",
            "type": "integer"
          },
          "stable_revision": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Stable Revision",
            "type": "integer"
          },
          "start_sample": {
            "title": "Start Sample",
            "type": "integer"
          },
          "state": {
            "enum": [
              "open",
              "final",
              "diverged",
              "abandoned"
            ],
            "title": "State",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "transcript.stable",
            "default": "transcript.stable",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "event_id",
          "segment_id",
          "segment_index",
          "stable_revision",
          "source_revision",
          "start_sample",
          "end_sample",
          "text",
          "state"
        ],
